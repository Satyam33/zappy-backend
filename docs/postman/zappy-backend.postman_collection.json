{
  "info": {
    "name": "Zappy Backend API",
    "_postman_id": "7d8e4c56-6f1e-49f7-b4ee-bf0b2f6a1d51",
    "description": "Module-wise API collection for frontend integration. Includes sample payloads, params, and expected outputs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "orgId", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "otpId", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "conversationId", "value": "00000000-0000-0000-0000-000000000010" },
    { "key": "campaignId", "value": "00000000-0000-0000-0000-000000000020" },
    { "key": "templateId", "value": "00000000-0000-0000-0000-000000000030" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication, OTP signup verification, token lifecycle, password recovery.",
      "item": [
        {
          "name": "Signup OTP Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup/otp/request", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "signup", "otp", "request"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@acme.com\",\n  \"mobile\": \"+919999999999\"\n}" },
            "description": "Requests OTP for signup. Validates both email and mobile uniqueness. In non-production, OTP code may be included in response."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"ok\": true,\n  \"otpId\": \"2d2b95a1-f6c5-475d-aad6-157f3029c0f5\",\n  \"expiresAt\": \"2026-03-24T12:12:00.000Z\",\n  \"otpCode\": \"123456\"\n}"
            }
          ]
        },
        {
          "name": "Signup OTP Verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup/otp/verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "signup", "otp", "verify"] },
            "body": { "mode": "raw", "raw": "{\n  \"otpId\": \"{{otpId}}\",\n  \"mobile\": \"+919999999999\",\n  \"otpCode\": \"123456\"\n}" },
            "description": "Verifies OTP. Must be done before signup."
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"ok\": true\n}" }]
        },
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "signup"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@acme.com\",\n  \"mobile\": \"+919999999999\",\n  \"password\": \"StrongPass123\",\n  \"name\": \"Acme Owner\",\n  \"organizationName\": \"Acme\",\n  \"otpId\": \"{{otpId}}\"\n}" },
            "description": "Creates user + organization + org admin membership."
          },
          "response": [{ "name": "201 Created", "status": "Created", "code": 201, "body": "{\n  \"ok\": true,\n  \"user\": {\n    \"id\": \"...\",\n    \"email\": \"owner@acme.com\",\n    \"mobile\": \"+919999999999\",\n    \"name\": \"Acme Owner\"\n  },\n  \"organization\": {\n    \"id\": \"...\",\n    \"name\": \"Acme\"\n  },\n  \"membership\": {\n    \"role\": \"admin\"\n  }\n}" }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@acme.com\",\n  \"password\": \"StrongPass123\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"ok\": true,\n  \"accessToken\": \"...\",\n  \"refreshToken\": \"...\"\n}" }]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"ok\": true,\n  \"accessToken\": \"...\",\n  \"refreshToken\": \"...\"\n}" }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"ok\": true\n}" }]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@acme.com\"\n}" }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"ok\": true\n}" }]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NewStrongPass123\"\n}" }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"ok\": true\n}" }]
        }
      ]
    },
    {
