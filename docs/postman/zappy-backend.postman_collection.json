          "name": "Meta Verify Webhook",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/webhook/whatsapp?hub.mode=subscribe&hub.verify_token=zappy-webhook-token&hub.challenge=123456",
              "host": ["{{baseUrl}}"],
              "path": ["webhook", "whatsapp"],
              "query": [
                { "key": "hub.mode", "value": "subscribe" },
                { "key": "hub.verify_token", "value": "zappy-webhook-token" },
                { "key": "hub.challenge", "value": "123456" }
              ]
            }
          },
          "response": [{ "name": "200 OK", "status": "OK", "code": 200, "body": "123456" }]
        },
        {
